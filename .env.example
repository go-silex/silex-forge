# Cloudflare Pages — local credentials (never commit)
#
# Copy to ~/.config/silex/forge.env and chmod 600
#   cp .env.example ~/.config/silex/forge.env
#
# publish.sh injects KV id + plain [vars] into wrangler.toml at deploy time
# so dashboard plain vars are not wiped. Secrets stay Pages-only.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# KV namespace bound as SHARES (CLI --share + wrangler patch)
FORGE_SHARES_KV_ID=

# Access JWT verification (injected as Pages plain vars on deploy)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional Shlink create URL (injected as plain var; key stays Pages secret)
SHLINK_API_URL=

# Optional overrides (normally from forge.config.json)
# PUBLIC_HOST=forge.example.com
# FORGE_PAGES_PROJECT=silex-forge
# SHLINK_DOMAIN=s.example.com
