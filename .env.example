# Cloudflare Pages — local credentials (never commit). chmod 600.
#
# Do not copy this file over an existing ~/.config/silex/forge.env — that
# wipes values forge-discover.sh --write already filled. Fill a missing
# file with `wrangler login` then `forge-discover.sh --write`; the API
# token is still manual. The public host and the Pages project name live
# in ~/.config/silex/forge.config.json (public_host, pages_project) and
# are not read from this file: a stale line here used to decide which
# Pages project a deploy landed in.

CLOUDFLARE_ACCOUNT_ID=
# Pages deploy + Workers KV Storage Edit (or use `wrangler login` OAuth as fallback for --share)
CLOUDFLARE_API_TOKEN=

# KV namespace bound as SHARES (CLI --share + wrangler patch)
FORGE_SHARES_KV_ID=

# Access JWT verification (injected as Pages plain vars on deploy)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Shlink create URL (injected as plain var; key stays Pages secret)
# If omitted locally, publish.sh preserves the value already on Pages.
SHLINK_API_URL=

# Optional override (normally from forge.config.json)
# SHLINK_DOMAIN=s.example.com
