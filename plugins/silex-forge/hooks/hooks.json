{
  "description": "silex-forge — vérifie la config locale (hub + artifacts) au SessionStart",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Checking forge config"
          }
        ]
      }
    ]
  }
}
